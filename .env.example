# Environment Configuration
NODE_ENV=development

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000

# Analytics (optional)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# Feature Flags
NEXT_PUBLIC_ENABLE_AI_CORE=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Contact form — Resend email delivery (server-side only).
# Put the real values in .env.local (gitignored). Never expose RESEND_API_KEY to the client.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=Albaraa Portfolio <onboarding@resend.dev>
